# Variables de entorno para PANORAMIX
# Copiar este archivo a .env.local y rellenar con tus keys

# OpenAI - Primera API Key (principal)
VITE_OPENAI_API_KEY_PRIMARY=sk-your-primary-key-here

# OpenAI - Segunda API Key (fallback si la primera falla)
VITE_OPENAI_API_KEY_SECONDARY=sk-your-secondary-key-here

# Modelo por defecto
VITE_OPENAI_MODEL=gpt-4o-mini

# Embedding model
VITE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
